<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    ORG CONVENTION: inherit from the internal starter parent, never from
    spring-boot-starter-parent directly. Replace the version below with the
    current internal parent release for the Spring Boot 4.0.x line.

    NOTE / ACTION REQUIRED: if the internal parent does not yet exist for the
    4.0.x line, raise it with java-platform@your-org before falling back to
    the public parent (per java-spring-conventions skill).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <groupId>com.milind</groupId>
  <artifactId>general-purpose-mcp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>general-purpose-mcp</name>
  <description>General-purpose MCP server exposing greeting and simple-interest tools over Streamable HTTP</description>

  <properties>
    <java.version>21</java.version>
    <!-- Spring AI is NOT pinned by the internal parent (yet), so the BOM import
         below is legitimate. If the parent later pins Spring AI, remove this. -->
    <spring-ai.version>2.0.0</spring-ai.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- MCP server over Spring MVC; Streamable HTTP transport enabled via
         spring.ai.mcp.server.protocol=STREAMABLE in application.yml -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
