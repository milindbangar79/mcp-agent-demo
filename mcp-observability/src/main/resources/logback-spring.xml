<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot's default console logging plus an OpenTelemetry appender, so every log line (including the
  "mcp.audit" JSON events) is also exported over OTLP (Loki). The appender is attached to the OpenTelemetry SDK
  by ObservabilityAutoConfiguration once the context is up; before that, records are buffered by the appender.
  A service that ships its own logback-spring.xml overrides this file.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
    <captureExperimentalAttributes>true</captureExperimentalAttributes>
    <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="OTEL"/>
  </root>
</configuration>
