        "x": 0,
        "y": 32
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Audit events per minute by type",
      "id": 21,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Counts of audit events written (llm.call, llm.tool.call, mcp.tool.invoke, agent.request).",
