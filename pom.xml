<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ORG CONVENTION (carried over from the per-module poms): inherit from the internal starter
       parent where one exists for this Boot line. Until then this reactor extends the public
       spring-boot-starter-parent, exactly as each module did before. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <groupId>com.milind</groupId>
  <artifactId>mcp-agent-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>mcp-agent-demo</name>
  <description>Parent/aggregator for the MCP agent demo: agents, MCP skill servers and shared libraries</description>

  <modules>
    <module>mcp-ratelimit</module>
    <module>finance-mcp</module>
    <module>research-mcp</module>
    <module>comms-mcp</module>
    <module>employee-mcp</module>
    <module>employee-agent</module>
    <module>general-purpose-mcp</module>
    <module>mcp-agent</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <spring-ai.version>2.0.1</spring-ai.version>
    <bucket4j.version>8.21.0</bucket4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.bucket4j</groupId>
        <artifactId>bucket4j_jdk17-core</artifactId>
        <version>${bucket4j.version}</version>
      </dependency>
      <!-- Internal shared library -->
      <dependency>
        <groupId>com.milind</groupId>
        <artifactId>mcp-ratelimit</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
